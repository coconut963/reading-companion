{
  "name": "reading-companion",
  "version": "1.1.1",
  "description": "AI 共读批注系统",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "cross-env BUILD_TARGET=electron vite build && electron-builder",
    "electron:build:win": "cross-env BUILD_TARGET=electron vite build && electron-builder --win nsis",
    "electron:build:portable": "cross-env BUILD_TARGET=electron vite build && electron-builder --win portable",
    "electron:build:all-win": "cross-env BUILD_TARGET=electron vite build && electron-builder --win nsis portable",
    "electron:build:mac": "cross-env BUILD_TARGET=electron vite build && electron-builder --mac dmg",
    "electron:build:linux": "cross-env BUILD_TARGET=electron vite build && electron-builder --linux AppImage tar.gz",
    "deploy": "vite build && gh-pages -d dist"
  },
  "build": {
    "appId": "com.readingcompanion.app",
    "productName": "共读",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "gh-pages": "^6.3.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "dexie": "^4.4.3",
    "jszip": "^3.10.1",
    "vue": "^3.5.38"
  }
}
